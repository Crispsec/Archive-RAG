import { useState } from "react";

function App() {
  const [query, setQuery] = useState("");
  const [results, setResults] = useState([]);

  const searchArchives = async () => {
    const res = await fetch("http://localhost:8000/mcp/search", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ query }),
    });
    const data = await res.json();
    setResults(data.results || []);
  };

  return (
    <div style={{ padding: 24, fontFamily: "sans-serif" }}>
      <h1>Archive MCP Search</h1>
      <input
        value={query}
        onChange={(e) => setQuery(e.target.value)}
        placeholder="Ask about coal output, flooding, etc."
        style={{ width: "80%", padding: 8, marginRight: 8 }}
      />
      <button onClick={searchArchives}>Search</button>

      {results.map((r) => (
        <div key={r.id} style={{ marginTop: 16 }}>
          <h2>{r.title}</h2>
          <p>{r.excerpt}</p>
          {r.iiif_manifest && (
            <iframe
              src={r.iiif_manifest}
              title={r.title}
              width="100%"
              height="400"
            />
          )}
        </div>
      ))}
    </div>
  );
}

export default App;
